---
import { site } from '@/data/site';
import Layout from '@/layouts/Layout.astro';
import { CalculatorApp } from '@/components/tools/CalculatorApp';
import { tools } from '@/data/tools';
import { toolDefinitions } from '@/data/toolDefinitions';
import { toolContent } from '@/data/toolContent';
import { toolSearchContent } from '@/data/searchContent';
import { serviceRoutes } from '@/data/services';
import { guides } from '@/data/guides';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

type Tool = (typeof tools)[number];
interface Props { tool: Tool }
const { tool }: Props = Astro.props;
const content = toolContent[tool.slug];
const definitions = toolDefinitions[tool.slug];
const relatedTools = tools.filter(item => (definitions.related as readonly string[]).includes(item.slug));
const searchContent = toolSearchContent[tool.slug];
const relatedGuide = guides.find(guide => guide.service === searchContent.service)!;
const relatedService = serviceRoutes.find(service => service.slug === searchContent.service)!;
const blogByTool = {
  'rto-simulator': { slug: 'rto-cost-guide', label: 'Read the complete RTO cost guide' },
  'unit-economics': { slug: 'unit-economics-guide', label: 'Read the complete unit economics guide' },
  'bundle-planner': { slug: 'bundle-pricing-guide', label: 'Read the complete bundle pricing guide' },
  'marketing-budget': { slug: 'marketing-budget-guide', label: 'Read the complete marketing budget guide' },
  'runway-planner': { slug: 'cash-runway-guide', label: 'Read the complete cash runway guide' },
  'inventory-planner': { slug: 'inventory-reorder-point-guide', label: 'Read the complete inventory reorder point guide' },
  'ecommerce-platform-profit': { slug: 'unit-economics-guide', label: 'Read the complete unit economics guide' },
  'website-d2c-profit': { slug: 'unit-economics-guide', label: 'Read the complete unit economics guide' },
} as const;
const relatedBlog = blogByTool[tool.slug];
---

<Layout>
  <div class="calculator-page">
    <header class="calculator-hero">
      <div class="shell">
        <a href="/tools" class="calculator-back"><span aria-hidden="true">←</span> All tools</a>
        <div class="calculator-title-row">
          <div>
            <p class="tools-kicker"><span aria-hidden="true"></span> {content.eyebrow}</p>
            <h1>{tool.title}</h1>
          </div>
          <p>{content.intro}</p>
        </div>
        <p class="calculator-free-note">Free to use · No signup · Calculations run in your browser · Amounts shown in INR</p>
        <nav class="tool-switcher" aria-label="Choose a calculator">
          {tools.map((item) => (
            <a href={`/tools/${item.slug}`} aria-current={item.slug === tool.slug ? 'page' : undefined}>
              <span>{item.number}</span>{item.title.replace(' Calculator', '').replace(' Planner', '')}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <nav class="shell calculator-jump-links" aria-label="On this calculator page"><a href="#calculator">Use calculator</a><a href="#calculation-method">Method &amp; example</a><a href="#input-definitions">Key terms</a><a href="#tool-faq-title">FAQs</a></nav>
    <section id="calculator" class="shell calculator-main" aria-label={`${tool.title} workspace`}>
      <CalculatorApp toolId={tool.slug} client:load />
      <div class="calculator-formula-bar">
        <span>Core calculation</span>
        <code>{tool.formula}</code>
      </div>
    </section>
    <p class="shell growth-note">Scenario estimate based on your inputs. It does not connect to your store or replace actual settlement and cost reports.</p>
    <noscript><p class="shell growth-note">Enable JavaScript to update the calculator. The formula, worked example and explanations below remain available without it.</p></noscript>
    <section class="section-space shell" aria-labelledby="calculation-method">
      <h2 id="calculation-method" class="section-title">How to use this calculator</h2>
      <div class="seo-help-grid"><div><p>{searchContent.steps}</p><h3>Worked example</h3><p>{searchContent.example}</p></div><div><h3>What the estimate leaves out</h3><p>{searchContent.limit}</p><p>Use inputs from the same reporting period and compare the result with your actual costs before making a decision.</p><a class="text-link" href={`/services/${relatedService.slug}`}>Explore {relatedService.navLabel.toLowerCase()} services ↗</a></div></div>
    </section>
    <p class="shell"><a class="text-link" href={`/guides/${relatedGuide.slug}`}>{relatedGuide.title} ↗</a> · <a class="text-link" href={`/blog/${relatedBlog.slug}`}>{relatedBlog.label} ↗</a></p>
    <section class="section-space shell" id="input-definitions" aria-labelledby="input-definitions-title"><h2 id="input-definitions-title" class="section-title">{definitions.question}</h2><dl class="tool-definitions">{definitions.terms.map(([term, explanation]) => <div><dt>{term}</dt><dd>{explanation}</dd></div>)}</dl></section>
    <section class="tool-education">
      <div class="shell">
        <div class="education-intro"><p class="eyebrow-accent">Why it matters</p><h2>{content.whyTitle}</h2><p>{content.whyIntro}</p></div>
        <ol class="education-grid">{content.reasons.map((reason, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{reason[0]}</h3><p>{reason[1]}</p></li>)}</ol>
      </div>
    </section>
    <section class="tool-faq shell" aria-labelledby="tool-faq-title">
      <div><p class="eyebrow-accent">Frequently asked</p><h2 id="tool-faq-title">Straight answers.</h2></div>
      <div>{content.faqs.map((faq) => <details><summary>{faq[0]}<span aria-hidden="true">+</span></summary><p>{faq[1]}</p></details>)}</div>
    </section>
    <section class="section-space shell"><h2 class="section-title">Check the next part of the picture.</h2><div class="seo-help-grid">{relatedTools.map(item => <article class="growth-card"><h3><a class="text-link" href={`/tools/${item.slug}`}>{item.title} ↗</a></h3><p>{item.description}</p></article>)}</div><p class="growth-note">Calculation method and examples maintained by <a class="text-link" href="/about">MlabsGrowth</a>. See the assumptions above before using an estimate.</p></section>
    <section class="section-space growth-product-band"><div class="shell growth-callout"><div><h2>Number worse than you expected?</h2><p>Bring it to a free 30-minute audit. We rank the leaks we can see and name the one to close first — the list is yours to keep.</p></div><a class="growth-button" href={site.bookingUrl} data-cta-location={`tool-${tool.slug}-audit`}>Book my free audit call ↗</a></div></section>
  </div>
</Layout>
