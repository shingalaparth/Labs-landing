---
import Layout from '@/layouts/Layout.astro';
import { tools } from '@/data/tools';
---

<Layout>
  <div class="tools-page">
    <section class="tools-masthead" aria-labelledby="tools-title">
      <div class="shell tools-masthead-inner">
        <p class="tools-kicker"><span aria-hidden="true"></span> Math-only tools for D2C operators</p>
        <h1 id="tools-title">Free ecommerce calculators.<br /><em>Decide with the numbers.</em></h1>
        <p class="tools-intro">Eight focused calculators for the operating questions that come up every week. No login, no email, no spreadsheet — type your numbers and get the answer in under a minute.</p>
        <div class="tools-proof" aria-label="Tool principles">
          <span>Runs in your browser</span>
          <span>Your inputs stay private</span>
          <span>Built for Indian D2C</span>
        </div>
      </div>
    </section>

    <section class="shell section-space" aria-labelledby="choose-tool"><h2 class="section-title" id="choose-tool">Which number do you need?</h2><div class="tool-definitions">{[
      ['What do failed deliveries cost?', 'rto-simulator', 'Compare COD and prepaid RTO costs.'],
      ['What does an order contribute?', 'unit-economics', 'Review variable costs and ad spend per order.'],
      ['Can this bundle support its discount?', 'bundle-planner', 'Compare bundle price, product margin and order value.'],
      ['How should I split my ad budget?', 'marketing-budget', 'Model channel allocations and ROAS assumptions.'],
      ['How long will current cash last?', 'runway-planner', 'Project cash balances over 24 months.'],
      ['When should I reorder inventory?', 'inventory-planner', 'Estimate reorder points and safety stock.'],
      ['Is this marketplace sale profitable?', 'ecommerce-platform-profit', 'Model commission, returns, logistics, ads and target price.'],
      ['Is this website order profitable?', 'website-d2c-profit', 'Model gateway fees, delivery costs, returns and ROAS.'],
    ].map(([question, slug, detail]) => <article><h3><a class="text-link" href={`/tools/${slug}`}>{question} ↗</a></h3><p>{detail}</p></article>)}</div></section>
    <section class="tools-catalog" aria-labelledby="catalog-title">
      <div class="shell">
        <div class="tools-catalog-heading">
          <div>
            <p class="eyebrow-accent">The toolkit</p>
            <h2 id="catalog-title">Eight numbers worth knowing.</h2>
          </div>
          <p>Each calculator answers one operating question and shows the formula behind the result.</p>
        </div>

        <div class="tool-grid">
          {tools.map((tool) => (
            <a class="tool-card" id={tool.slug} href={`/tools/${tool.slug}`} aria-label={`Open ${tool.title}`}>
              <div class="tool-card-top">
                <span class="tool-number">{tool.number}</span>
                <span class="tool-status">Open tool <span aria-hidden="true">↗</span></span>
              </div>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
              <ul aria-label={`${tool.title} results`}>
                {tool.outputs.map((output) => <li><span aria-hidden="true">+</span>{output}</li>)}
              </ul>
              <div class="tool-formula">
                <span>Core calculation</span>
                <code>{tool.formula}</code>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
