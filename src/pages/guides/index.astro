---
import Layout from '@/layouts/Layout.astro';
import { guides } from '@/data/guides';
---
<Layout><div class="growth-page"><section class="growth-page-hero shell"><p class="eyebrow-accent">PRACTICAL GUIDES</p><h1>D2C growth &amp;<br /><em>AI workflow guides.</em></h1><p class="growth-lead">Diagnose the problem, put a number on it, then decide what to do about it. Each guide pairs with a free calculator so you can run your own figures before anyone quotes you anything.</p></section><section class="section-space shell seo-help-grid" aria-label="Guides">{guides.map(guide => <article class="growth-card"><h2>{guide.title}</h2><p>{guide.description}</p><a class="text-link" href={`/guides/${guide.slug}`}>Read the guide ↗</a></article>)}</section></div></Layout>
