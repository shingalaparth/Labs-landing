<script>
  const approach = document.querySelector<HTMLElement>('.approach-section');
  if (approach && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    const updateVisualScale = () => {
      frame = 0;
      const styles = window.getComputedStyle(approach);
      const visualTop = approach.getBoundingClientRect().top + Number.parseFloat(styles.paddingTop);
      const start = window.innerHeight * 0.82;
      const distance = window.innerHeight * 0.45;
      const progress = Math.min(1, Math.max(0, (start - visualTop) / distance));
      const initialScale = Number.parseFloat(styles.getPropertyValue('--visual-start-scale'));
      const initialLift = Number.parseFloat(styles.getPropertyValue('--visual-start-lift'));
      approach.style.setProperty('--visual-scale', String(initialScale - progress * (initialScale - 1)));
      approach.style.setProperty('--visual-lift', `${initialLift * (1 - progress)}px`);
    };
    const queueUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateVisualScale);
    };
    updateVisualScale();
    window.addEventListener('scroll', queueUpdate, { passive: true });
    window.addEventListener('resize', queueUpdate);
  }
</script>

