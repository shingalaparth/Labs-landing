---
import '@fontsource-variable/manrope/wght.css';
import { contactEmail, site } from '@/data/site';
import { faqs } from '@/data/commerce';
import { pageSeo } from '@/data/seo';
import { metaPixelNoscriptSrc, metaPixelScript } from '@/data/metaPixel';
import { ownedBrands, ownershipDisclosure } from '@/data/experience';
import { ConversionEvents } from '@/components/providers/ConversionEvents';
import HiveNavbar from '@/components/layout/HiveNavbar.astro';
import { Footer } from '@/components/layout/Footer';
import BeeOrbit from '@/components/bees/BeeOrbit.astro';
import { beeCharacters, queenBee as queen } from '@/data/bees';
import humanStrategist from '../../asset/human-creative-strategist.png';

const { image: marketingBee } = beeCharacters.marketing;
const { image: shopifyBee } = beeCharacters.shopify;
const { image: callingBee } = beeCharacters.calling;
const { image: brandBee } = beeCharacters.brand;
const seo = pageSeo['/'];
const canonicalUrl = site.url ? new URL('/', site.url).href : undefined;
const socialImageUrl = new URL('/social-preview.png', site.url || Astro.url.origin).href;
const organizationId = `${site.url}/#organization`;
const websiteId = `${site.url}/#website`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: site.name, url: site.url, email: contactEmail || undefined, description: site.tagline },
    { '@type': 'WebSite', '@id': websiteId, name: site.name, url: canonicalUrl, publisher: { '@id': organizationId }, inLanguage: 'en' },
    { '@type': 'WebPage', '@id': `${canonicalUrl}#webpage`, url: canonicalUrl, name: `${seo.title} — ${site.name}`, description: seo.description, isPartOf: { '@id': websiteId }, publisher: { '@id': organizationId }, inLanguage: 'en' },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/hero/quicksand-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#fbfaf8" />
    <meta name="robots" content={site.indexable ? 'index, follow' : 'noindex, follow'} />
    <meta name="googlebot" content={`${site.indexable ? 'index, follow' : 'noindex, follow'}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`} />
    <meta name="author" content={site.name} />
    <meta name="description" content={seo.description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${seo.title} — ${site.name}`} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={socialImageUrl} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${seo.title} — ${site.name}`} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{seo.title} — {site.name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site.url && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    {site.indexable && <script is:inline set:html={metaPixelScript}></script>}
  </head>
  <body>
    {site.indexable && <noscript><img height="1" width="1" style="display:none" alt="" src={metaPixelNoscriptSrc} /></noscript>}
    <div class="hive-page">
      <a class="skip-link" href="#main">Skip to content</a>
      <ConversionEvents client:load />
      <HiveNavbar />

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title"><span>More delivered orders.</span><span>Less work behind them.</span></h1>
            <p class="hero-subtitle">You already pay for the traffic. We work on what happens after the click — the Shopify pages that lose the sale, the COD orders nobody confirms, and the follow-up your team still does by hand.</p>
            <a class="pill-button hero-cta" href={site.bookingUrl} data-cta-location="home-hero">
              <span>Book my free audit call</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span>
            </a>
            <p class="hero-note">Free 30-minute audit. We rank the leaks we can see — yours to keep.</p>
          </div>

        </section>

        <section id="approach" class="approach-section" aria-labelledby="approach-title">
          <h2 id="approach-title" class="sr-only">One hive. Two ways to grow.</h2>
          <div class="offer-grid">
            <div class="offer-column">
              <div class="offer-visual human-visual">
                <span class="visual-halo" aria-hidden="true"></span>
                <img src={humanStrategist.src} width="1149" height="1368" alt="Illustrative portrait of a human strategist" fetchpriority="high" />
              </div>
              <article class="offer-card">
                <h3>Don't hire more <em>humans.</em></h3>
                <p class="offer-description">A new hire absorbs the repetitive work; it does not remove it. It comes back at the next festive spike, and by then it costs more. Keep your team on judgment, creative and approvals.</p>
                <div class="offer-signature"><span class="signature-dot" aria-hidden="true"></span>Human-led. Brand-focused.</div>
                <a class="pill-button offer-cta" href="/services" data-cta-location="home-hire-humans"><span>See what we fix</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span></a>
              </article>
            </div>
            <div class="offer-column">
              <div class="offer-visual agents-visual">
                <span class="visual-halo" aria-hidden="true"></span>
                <img class="offer-bee bee-queen" src={queen.src} width="1254" height="1254" alt="The queen bee leads a hive of specialist agents." />
                <img class="offer-bee bee-satellite-left" src={shopifyBee.src} width="1254" height="1254" alt="" aria-hidden="true" />
                <img class="offer-bee bee-satellite-right" src={marketingBee.src} width="1254" height="1254" alt="" aria-hidden="true" />
              </div>
              <article class="offer-card">
                <h3>Hire AI Agents.</h3>
                <p class="offer-description">One agent for store conversion, one for COD and delivery follow-up, one for marketing. They read the same live order data, so nobody asks a customer something they already answered.</p>
                <div class="offer-signature"><span class="signature-bees" aria-hidden="true"><img src={shopifyBee.src} width="30" height="30" alt="" loading="lazy" /><img src={marketingBee.src} width="30" height="30" alt="" loading="lazy" /><img src={callingBee.src} width="30" height="30" alt="" loading="lazy" /></span>One queen. A connected hive.</div>
                <a class="pill-button offer-cta" href="#services" data-cta-location="home-hire-agents"><span>Explore agents</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span></a>
              </article>
            </div>
          </div>
          <p class="approach-note">Your people stay in control and approve the work. The hive takes the repetitive part off their day.</p>
        </section>

        <section id="services" class="services-section" aria-labelledby="services-title">
          <p class="eyebrow">ONE BRAIN. ONE SET OF LIVE ORDERS.</p>
          <h2 id="services-title">Meet your new team<br />of AI bees<span class="yellow-period">.</span></h2>
          <p class="services-intro">Each bee owns one job. All of them read the same live order data, which is what makes them worth more together than apart.</p>
          <div class="team-orbit">
            <BeeOrbit />
          </div>
        </section>

        <section id="how-it-works" class="brain-section" aria-labelledby="brain-section-title">
          <h2 id="brain-section-title">How it works.</h2>
          <div id="queen-brand-brain" class="brain-grid queen-grid">
            <div class="brain-copy store-copy queen-copy">
              <p class="store-eyebrow">THE QUEEN BEE</p>
              <h3>Your brand's<br />second brain.</h3>
              <p>Right now your brand lives in chats, decks and somebody's head, and every new task starts by explaining it again. The Queen Bee keeps your approved products, customers, voice and past decisions in one place, then hands the right context to every specialist.</p>
              <ul class="store-steps" aria-label="How the Queen Bee helps the hive">
                <li><span class="store-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="16" rx="2" /><path d="M9 9h6M9 13h6M9 17h4" /></svg></span><span>Keep approved brand knowledge together</span></li>
                <li><span class="store-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2" /><circle cx="5" cy="18" r="2" /><circle cx="19" cy="18" r="2" /><path d="M11 7 6 16m7-9 5 9" /></svg></span><span>Guide every specialist with the right context</span></li>
                <li><span class="store-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /><circle cx="12" cy="12" r="9" /></svg></span><span>Keep final approval with your team</span></li>
              </ul>
              <a class="brain-link" href="/services/ai-automation">
                <img src={brandBee.src} width="1254" height="1254" alt="" loading="lazy" />
                <span>Explore Brand Brain</span>
                <span class="brain-link-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </a>
            </div>
            <div class="brain-video-shell">
              <div class="brain-video-stage">
                <video data-showcase-video autoplay muted loop playsinline preload="metadata" poster="/video/queen-brand-brain-poster.png" aria-label="Queen Bee animation: approved brand knowledge guides specialist agents while the team reviews their work">
                  <source src="/video/queen-brand-brain.mp4" type="video/mp4" />
                  Your browser does not support this video.
                </video>
              </div>
            </div>
          </div>
        </section>

        <section id="shopify-growth" class="brain-section store-section" aria-labelledby="shopify-growth-title">
          <div class="brain-grid">
            <div class="brain-copy store-copy">
              <p class="store-eyebrow">SHOPIFY STORE GROWTH</p>
              <h3 id="shopify-growth-title">Turn visits<br />into orders.</h3>
              <p>You bought the click. They landed on the wrong product, did not find the proof they needed, and left — then you paid again to bring them back. We work on the steps in between, and judge it on conversion, order value and margin together.</p>
              <ul class="store-steps" aria-label="Where we improve the store">
                <li><span class="store-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5" /><path d="m15 15 5 5" /></svg></span><span>Help shoppers find the right product</span></li>
                <li><span class="store-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 8h6M9 12h6M9 16h4" /></svg></span><span>Answer product questions before checkout</span></li>
                <li><span class="store-step-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h2l2 11h12l2-8H6M9 20h.01M17 20h.01" /></svg></span><span>Suggest relevant cart additions</span></li>
              </ul>
              <a class="brain-link" href="/services/store-conversion">
                <img src={shopifyBee.src} width="1254" height="1254" alt="" loading="lazy" />
                <span>Explore store conversion</span>
                <span class="brain-link-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </a>
            </div>
            <div class="brain-video-shell">
              <div class="brain-video-stage">
                <video data-showcase-video autoplay muted loop playsinline preload="metadata" poster="/video/shopify-growth-poster.png" aria-label="Shopify store growth animation: shoppers discover products, then product details and relevant cart additions are improved">
                  <source src="/video/shopify-growth.mp4" type="video/mp4" />
                  Your browser does not support this video.
                </video>
              </div>
            </div>
          </div>
        </section>

        <section id="marketing-brain" class="brain-section">
          <div class="brain-grid">
            <div class="brain-copy store-copy">
              <p class="store-eyebrow">MARKETING BRAIN</p>
              <h3>Marketing Brain.<br/>For Better Ads.</h3>
              <p>Your marketing should not start from zero every Monday. Marketing Brain keeps approved brand knowledge, real customer questions and what past campaigns taught you in one working context, then turns it into content ideas, creative briefs and ad angles. Your team reviews the output; managed marketing puts approved campaigns into market.</p>
              <a class="brain-link" href="/services/ai-automation">
                <img src={marketingBee.src} width="1254" height="1254" alt="" loading="lazy" />
                <span>Marketing Brain</span>
                <span class="brain-link-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </a>
            </div>
            <div class="brain-video-shell">
              <div class="brain-video-stage">
                <video data-showcase-video autoplay muted loop playsinline preload="metadata" poster="/video/marketing-brain-flow-poster.png" aria-label="Marketing Brain animation: approved brand and campaign context becomes creative ideas for human review">
                  <source src="/video/marketing-brain-flow.mp4" type="video/mp4" />
                  Your browser does not support this video.
                </video>
              </div>
            </div>
          </div>
        </section>

        <section class="proof-section" aria-labelledby="proof-title">
          <div class="proof-inner">
            <div class="proof-heading">
              <h2 id="proof-title">We built this for our<br />own brands first.</h2>
              <p>By <strong><span>Mlabs</span>Growth.</strong></p>
            </div>
            <div class="proof-stats" aria-label="How we work">
              <div><strong>{ownedBrands.length}</strong><span>D2C brands we own and run</span></div>
              <div><strong>3</strong><span>festive peaks a year</span></div>
              <div><strong>30 min</strong><span>free audit, yours to keep</span></div>
            </div>
            <div class="proof-gallery" aria-label="Illustrations of our people, agents, and workflows">
              <figure class="proof-image proof-approval">
                <div class="approval-ui">
                  <div class="approval-header">
                    <div class="approval-avatar"></div>
                    <div class="approval-text">
                      <div class="line short"></div>
                      <div class="line long"></div>
                    </div>
                  </div>
                  <div class="approval-actions">
                    <div class="action-btn decline"></div>
                    <div class="action-btn approve">
                      <div class="cursor-pointer">
                         <svg viewBox="0 0 24 24"><path d="M5.5 3.21V20.8c0 .45.54.67.85.35l4.86-4.86 2.89 7.23c.18.45.69.67 1.13.49l2.26-.9c.45-.18.67-.69.49-1.13l-2.89-7.23 6.64-.15c.45-.01.65-.56.32-.86L6.35 2.86c-.32-.3-.85-.07-.85.35z" fill="#fff" stroke="#131313" stroke-width="1.5"/></svg>
                      </div>
                    </div>
                  </div>
                </div>
                <figcaption>Human-led decisions</figcaption>
              </figure>
              <figure class="proof-image proof-honeycomb">
                <div class="hex-grid">
                  <div class="hex-row hex-row-1">
                    <div class="hex"></div>
                    <div class="hex"></div>
                  </div>
                  <div class="hex-row hex-row-2">
                    <div class="hex"></div>
                    <div class="hex hex-center"></div>
                    <div class="hex"></div>
                  </div>
                  <div class="hex-row hex-row-3">
                    <div class="hex"></div>
                    <div class="hex"></div>
                  </div>
                </div>
                <figcaption>One connected hive</figcaption>
              </figure>
              <figure class="proof-image proof-dashboard">
                <div class="dash-container">
                  <div class="dash-item item-1"></div>
                  <div class="dash-item item-2"></div>
                  <div class="dash-item item-3"></div>
                </div>
                <figcaption>Specialists for the work</figcaption>
              </figure>
            </div>
            <div class="proof-brands">
              <h3>Grounded in our own businesses.</h3>
              <div class="proof-brand-list">{ownedBrands.map(brand => <span>{brand.name}</span>)}</div>
            </div>
            <p class="proof-disclosure">{ownershipDisclosure}</p>
          </div>
        </section>

        <section class="closing-cta" aria-labelledby="closing-title">
          <div class="closing-lines" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="closing-copy">
            <h2 id="closing-title">Which leak is costing you the most right now?</h2>
            <a class="pill-button" href={site.bookingUrl} data-cta-location="home-closing"><span>Book my free audit call</span><span class="pill-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></span></a>
            <p>Bring one problem. We rank the leaks we can see and tell you which to close first — yours to keep.</p>
          </div>
        </section>

         <section id="faq" class="home-faq" aria-labelledby="faq-title">
          <div class="faq-inner">
            <h2 id="faq-title">FAQ<span>.</span></h2>
            <div class="faq-list">
              {faqs.map(faq => (
                <details class="faq-item" name="home-faq">
                  <summary><span>{faq.question}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
                  <div class="faq-answer"><p>{faq.answer}</p></div>
                </details>
              ))}
            </div>
          </div>
        </section>

      </main>
      <Footer ctaLocation="home-footer" />
    </div>
  </body>
</html>

<style>
  @font-face { font-family: 'Quicksand Hero'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/hero/quicksand-500-latin.woff2') format('woff2'); }
  @font-face { font-family: Caveat; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/caveat/caveat-medium.ttf') format('truetype'); }
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; }
  :global(:focus-visible) { outline: 2px solid #986500; outline-offset: 5px; }
  .hive-page { --ink: #131313; --muted: #707178; --yellow: #ffcc1e; --cream: #f6f5f1; min-width: 320px; overflow: clip; background: var(--cream); color: var(--ink); font-family: 'Manrope Variable', Manrope, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  h1,h2,h3,p { margin-top: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .skip-link { position: fixed; z-index: 100; top: -100px; left: 18px; padding: 12px 16px; background: #fff; border-radius: 12px; }
  .skip-link:focus { top: 10px; }
  .pill-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 54px; padding: 5px 5px 5px 24px; border-radius: 999px; background: #facc15; box-shadow: 0 6px 15px rgba(0,0,0,0.06), inset 0 -3px 5px rgba(220,160,0,0.35), inset 0 3px 5px rgba(255,255,255,0.5); font-size: 15px; font-weight: 800; white-space: nowrap; transition: transform .25s, box-shadow .25s; }
  .pill-button:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(0,0,0,0.08), inset 0 -3px 5px rgba(220,160,0,0.35), inset 0 3px 5px rgba(255,255,255,0.5); }
  .pill-button:hover .pill-arrow { transform: scale(1.05); }
  .pill-arrow { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 auto; border: none; border-radius: 50%; background: linear-gradient(180deg, #ffe066 0%, #ffc000 100%); box-shadow: inset 0 2px 3px rgba(255,255,255,0.9), 0 2px 5px rgba(0,0,0,0.15); transition: transform .25s; }
  .pill-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .hero { padding: clamp(180px,13.7vw,240px) 24px 0; }
  .hero-copy { max-width: 900px; margin: 0 auto; text-align: center; }
  h1 { margin-bottom: 30px; font-family: 'Quicksand Hero', 'Manrope Variable', sans-serif; font-size: clamp(46px,5vw,78px); line-height: 1.08; font-weight: 500; letter-spacing: -.065em; }
  h1 span { display: block; text-wrap: balance; }
  .hero-subtitle { max-width: 690px; margin: 0 auto 30px; color: var(--muted); font-size: clamp(16px,1.25vw,20px); line-height: 1.55; letter-spacing: -.025em; }
  .hero-cta { min-width: 250px; min-height: 50px; margin: 0 auto; font-size: 14px; }
  .hero-cta .pill-arrow { width: 40px; height: 40px; }
  .hero-note { margin: 15px auto 0; color: #777872; font-size: 12px; line-height: 1.5; }
  .approach-section { position: relative; padding: 145px 24px 40px; scroll-margin-top: 120px; --visual-start-scale: 1.38; --visual-scale: 1.38; --visual-start-lift: 70px; --visual-lift: 70px; }
  .offer-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28px; max-width: 900px; margin: auto; }
  .offer-column { min-width: 0; display: flex; flex-direction: column; }
  .offer-visual { position: relative; height: 370px; isolation: isolate; transform: translateY(calc(-1 * var(--visual-lift))) scale(var(--visual-scale)); transform-origin: center bottom; transition: transform .18s ease-out; }
  .visual-halo { position: absolute; z-index: -1; left: 50%; bottom: 0; width: 110%; height: 270px; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(ellipse,#f1d9c752,transparent 70%); filter: blur(25px); }
  .human-visual img { position: absolute; left: 50%; top: 7px; width: 440px; max-width: 112%; height: auto; transform: translateX(-50%); filter: drop-shadow(0 12px 16px #76562c0a); }
  .agents-visual .visual-halo { background: radial-gradient(ellipse,#ffe5ad66,transparent 70%); }
  .offer-bee { position: absolute; height: auto; filter: drop-shadow(0 14px 17px #95661c1f); }
  .bee-queen { z-index: 1; width: 340px; max-width: 84%; top: 0; left: 0; right: 0; margin-inline: auto; animation: queen-float 7s ease-in-out infinite; }
  .bee-satellite-left { z-index: 2; left: -13px; bottom: -8px; width: 175px; transform: rotate(-10deg); animation: satellite-left-float 6s ease-in-out infinite; }
  .bee-satellite-right { z-index: 2; right: -10px; bottom: -18px; width: 174px; transform: rotate(10deg); animation: satellite-right-float 6.5s ease-in-out infinite; }
  .offer-card { position: relative; z-index: 3; flex: 1; display: flex; flex-direction: column; min-height: 320px; padding: 35px 36px 34px; border: 1px solid #ffffffb3; border-radius: 23px; background: #fff; box-shadow: 0 10px 28px #4b3c1805; }
  .offer-card h3 { margin-bottom: 16px; font-size: clamp(28px,2.5vw,36px); line-height: 1.15; font-weight: 750; letter-spacing: -.055em; }
  .offer-card h3 em { display: inline-block; font-family: Caveat, 'Segoe Print', cursive; font-size: 1.27em; font-style: normal; font-weight: 500; line-height: .8; letter-spacing: -.04em; }
  .offer-description { margin-bottom: 26px; color: var(--muted); font-size: 16px; line-height: 1.6; letter-spacing: -.015em; }
  .offer-card ul { display: grid; gap: 13px; margin: 0 0 25px; padding: 20px 0 0; border-top: 1px solid #ebebe6; list-style: none; color: #484848; font-size: 14px; line-height: 1.55; }
  .offer-card li { position: relative; padding-left: 13px; }
