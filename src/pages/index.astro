  showcaseVideos.forEach(video => videoObserver.observe(video));
  reducedMotion.addEventListener('change', () => showcaseVideos.forEach(video => {
    if (reducedMotion.matches) video.pause();
    else if (video.getBoundingClientRect().top < innerHeight && video.getBoundingClientRect().bottom > 0) video.play().catch(() => {});
  }));
</script>
