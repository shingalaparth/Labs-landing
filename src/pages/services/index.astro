---
import { site } from '@/data/site';
import Layout from '@/layouts/Layout.astro';
import { guides } from '@/data/guides';
import PlatformFamily from '@/components/sections/PlatformFamily.astro';
import { Services } from '@/components/sections/Services';
import { Approach } from '@/components/sections/Approach';
import { Faq } from '@/components/sections/Faq';
import { Contact } from '@/components/sections/Contact';
import OperatingExperience from '@/components/ui/OperatingExperience.astro';
import { audiences } from '@/data/audiences';
import { ArrowIcon } from '@/components/ui/MagneticButton';
import salesAgentBee from '../../../asset/individual-bees/04-shopify-sales-agent-no-name.png';
---
<Layout>
  <section id="top" class="growth-hero">
    <div class="shell growth-hero-grid">
      <div>
        <p class="growth-eyebrow">MlabsGrowth · BRAND SERVICES FOR D2C</p>
        <h1>Fix what happens<br /><em>after the click,<br />and after the order.</em></h1>
        <p class="growth-lead">Three services for D2C brands on Shopify: the pages that lose the sale, the COD orders that never turn into delivered revenue, and the marketing that restarts from zero every Monday. Start with the one costing you the most.</p>
        <div class="growth-actions"><a class="growth-button" href={site.bookingUrl} data-cta-location="home-audit">Book my free audit call <span aria-hidden="true">↗</span></a><a class="growth-text-link" href="/products">Prefer to run it yourself? See products <span aria-hidden="true">↗</span></a></div>
        <p class="growth-note">Free 30-minute audit. We rank the leaks we can see — the list is yours to keep. Written scope before any paid work.</p>
      </div>
      <figure class="growth-diagram"><img src={salesAgentBee.src} width="640" height="640" alt="Shopify sales agent" fetchpriority="high" /><figcaption>How we scope a connected workflow · illustrative example</figcaption></figure>
    </div>
    <div class="shell"><div class="growth-trust"><span>We run 2 D2C brands ourselves</span><span>One fixed scope, in writing</span><span>Built in your accounts, not ours</span></div></div>
  </section>
  <PlatformFamily />
  <Services />
  <section id="who-its-for" class="audience-section section-space" aria-labelledby="who-its-for-title">
    <div class="shell">
      <div class="section-intro">
        <span class="section-label"><span>02 /</span> Who it’s for</span>
        <div>
          <h2 id="who-its-for-title" class="section-title">Same building blocks.<br /><span class="muted-heading">Built around who you sell to.</span></h2>
          <p class="section-description">Selling to shoppers and selling to other businesses leak in different places. Pick the page that matches how you sell — each shows the gaps we look for, what we build and whether we are a fit.</p>
        </div>
      </div>
      <div class="service-route-grid audience-card-grid">
        {audiences.map(audience => (
          <a id={`for-${audience.id}`} href={`/services/${audience.slug}`} class="service-route-card">
            <div class="service-top"><span>{audience.id.toUpperCase()}</span><span>{audience.label}</span></div>
            <h3>{audience.navDescription}</h3>
            <p>{audience.description.split('. ')[0]}.</p>
            <ul aria-label={`${audience.label}: built for`}>{audience.builtFor.slice(0, 4).map(item => <li>{item}</li>)}</ul>
            <span class="service-route-action">See the {audience.id.toUpperCase()} page <ArrowIcon /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section id="proof" class="section-space growth-evidence">
    <div class="shell growth-split"><div><p class="eyebrow-accent">THE EXPERIENCE BEHIND THE WORK</p><h2 class="section-title">We know what happens<br /><span class="muted-heading">after the order comes in.</span></h2><p>We run seasonal products at Sanskrutibydiorin and daily jewellery operations at Diorin Demifine Jewellery. Same questions you have: what needs confirming, what is actually in stock, who handles the next exception, and why the dashboard says growth while the team is drowning.</p><p>These are our own brands, not independent client case studies. We use that operating experience to ask better questions about your business and scope the work around your real constraints — not a template.</p><a class="text-link" href="/about">Meet Mehul and see the approach ↗</a></div><OperatingExperience /></div>
  </section>
  <section class="section-space growth-product-band" aria-labelledby="product-heading"><div class="shell growth-split"><div><p class="eyebrow-accent">FOR PEOPLE WHO WANT TO RUN THEIR OWN WORKFLOWS</p><h2 class="section-title" id="product-heading">Useful AI work.<br /><span class="muted-heading">A place to organise it.</span></h2><p>We’re building mlabs Skill Manager to help you organise AI skills, schedule recurring work, and review outputs in one place. A skill is a set of instructions for a repeatable AI task, such as an audit or a content brief.</p><a href="/products/skill-manager" class="growth-button">Explore Skill Manager <span aria-hidden="true">↗</span></a></div><article class="growth-card"><span class="growth-status">IN DEVELOPMENT · NOT YET FOR SALE</span><h3>From a saved prompt<br />to a repeatable routine.</h3><ol class="growth-steps"><li><span>01</span>Choose the task and its project context.</li><li><span>02</span>Set when you want it to run.</li><li><span>03</span>Review the output before using it.</li></ol><p>Pricing, supported setup and release timing are still being finalised. Product interest is separate from a service enquiry.</p></article></div></section>
  <Approach />
  <section class="section-space shell" aria-labelledby="guides-title"><p class="eyebrow-accent">START WITH A USEFUL QUESTION</p><h2 class="section-title" id="guides-title">Put a number on it<br /><span class="muted-heading">before you book anything.</span></h2><div class="seo-help-grid">{guides.map(guide => <article class="growth-card"><h3>{guide.title}</h3><p>{guide.description}</p><a class="text-link" href={`/guides/${guide.slug}`}>Read the guide ↗</a></article>)}</div></section>
  <Faq />
  <Contact />
</Layout>
